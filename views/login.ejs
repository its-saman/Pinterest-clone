<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style2.css">
    <title>PinterestClone</title>
</head>
<body>
    <div class="container">
        <div class="content">
          
          <img src="https://i.pinimg.com/originals/d3/d1/75/d3d175e560ae133f1ed5cd4ec173751a.png" alt="pin logo" class="img1" />
          <p class="header">Login to see more</p>

            
            <% if(error.length > 0){ %>
            <p class="error"> <%= error %></p>
        <% }  %>

          <form action="/login" method="post">
          

          <input type="text" name="username" placeholder="Username" class="detail" /><br />

          <input type="password" name="password" placeholder="Password" class="detail" />

          <input type="submit" class="btn int" value="Login">
        </form>
   
          
        <h4>Dont remember password?<a href="/forget">Forgot password</a></h4>
        
        <footer>
            <p>
              By continuing, you agree to Pinterest's
              <b>Terms of Service, Privacy policy.</b>
            </p>
            <hr />
            <p>Dont have an account? <a href="/profile">Sign up </a></p>
          </footer>
        </div>
      </div>
      <a href="#demo" class="upbtn">Sign up</a>
</body>
</html>